DATABASE_URL="postgresql://virtualtour:change-me@localhost:5432/virtual_tour_lrt?schema=public"

S3_ENDPOINT=https://object-storage.example.internal
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET=virtual-tour-lrt
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Hanya diperlukan saat menjalankan npm run db:seed.
ALLOW_DESTRUCTIVE_SEED=false
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_EMAIL=admin@example.internal
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters


