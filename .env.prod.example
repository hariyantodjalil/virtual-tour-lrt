LRT_VIRTUALTOUR_IMAGE=lrt-virtualtour:prod
VIRTUALTOUR_STACK_NAME=lrt-prod-virtualtour
VIRTUALTOUR_CONTAINER_NAME=lrt-prod-virtualtour-web
VIRTUALTOUR_DB_CONTAINER_NAME=lrt-prod-virtualtour-db
VIRTUALTOUR_NETWORK_NAME=lrt-prod-virtualtour-network
VIRTUALTOUR_DB_VOLUME_NAME=lrt-prod-virtualtour-postgres-data
VIRTUALTOUR_HTTP_BIND=0.0.0.0
VIRTUALTOUR_HTTP_PORT=80

POSTGRES_DB=virtual_tour_lrt
POSTGRES_USER=virtualtour
POSTGRES_PASSWORD=change-me-prod
DATABASE_URL=postgresql://virtualtour:change-me-prod@postgres:5432/virtual_tour_lrt?schema=public

S3_ENDPOINT=https://object-storage.example.internal
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET=virtual-tour-lrt
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (Sign-in dengan Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

ALLOW_DESTRUCTIVE_SEED=false
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_EMAIL=admin@example.internal
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters

