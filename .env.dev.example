LRT_VIRTUALTOUR_IMAGE=lrt-virtualtour:dev
VIRTUALTOUR_STACK_NAME=lrt-dev-virtualtour
VIRTUALTOUR_NETWORK_NAME=lrt-dev-virtualtour-network
VIRTUALTOUR_DB_VOLUME_NAME=lrt-dev-virtualtour-postgres-data
VIRTUALTOUR_HTTP_BIND=0.0.0.0
VIRTUALTOUR_HTTP_PORT=5011

POSTGRES_DB=virtual_tour_lrt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/virtual_tour_lrt?schema=public

S3_ENDPOINT=https://object-storage.example.internal
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET=virtual-tour-lrt
NEXTAUTH_SECRET=change-me-dev
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Jakarta
