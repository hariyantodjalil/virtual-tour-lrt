generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(EDITOR)
  isActive  Boolean  @default(true)
  tenantLeads TenantLead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Station {
  id                String              @id @default(cuid())
  code              String?             @unique // Kode stasiun resmi (DKA, SET, dll.) — selaras portal-lrt
  name              String
  nameId            String?             // Nama tampilan ID (biasanya sama dengan name)
  slug              String              @unique
  line              String
  address           String
  location          String?             // Wilayah: Jakarta Selatan, Kota Bekasi, dll.
  dailyPassengers   Int                 @default(0)
  latitude          Float?
  longitude         Float?
  imageUrl          String?
  description       String?
  commercialContactPhone String?        @default("628118012012")
  order             Int                 @default(0)
  isActive          Boolean             @default(true)
  commercialSpaces  CommercialSpace[]
  visitEvents       VisitEvent[]
  virtualTourScenes VirtualTourScene[]
  virtualTourLevels VirtualTourLevel[]
  virtualTourAreas  VirtualTourArea[]
  virtualTour       StationVirtualTour?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("stations")
}

// Agregat konfigurasi virtual tour per stasiun — paralel station_floorplans di portal-lrt.
// Scene & hotspot tetap dinormalisasi di virtual_tour_scenes.
model StationVirtualTour {
  id        String   @id @default(cuid())
  stationId String   @unique
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // defaultSceneId, initialViews per scene, editorSettings
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("station_virtual_tours")
}

// Level tur per stasiun: Concourse, Peron, Outdoor, dll.
model VirtualTourLevel {
  id        String             @id @default(cuid())
  stationId String
  station   Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  color     String             @default("#10b981")
  hint      String?
  order     Int                @default(0)
  isActive  Boolean            @default(true)
  areas     VirtualTourArea[]
  scenes    VirtualTourScene[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stationId, slug])
  @@map("virtual_tour_levels")
}

// Area dalam level: Paid Concourse, Unpaid Concourse, koridor A, dll.
model VirtualTourArea {
  id        String             @id @default(cuid())
  stationId String
  station   Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  levelId   String
  level     VirtualTourLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  order     Int                @default(0)
  isActive  Boolean            @default(true)
  scenes    VirtualTourScene[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stationId, slug])
  @@map("virtual_tour_areas")
}

model VirtualTourScene {
  id           String            @id @default(cuid())
  stationId    String
  station      Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  levelId      String?
  levelRef     VirtualTourLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  areaId       String?
  areaRef      VirtualTourArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sceneId      String            // slug scene: concourse, gate-area, platform
  title        String
  panoramaUrl  String            // path S3 equirectangular — paralel svgPath di floorplan
  level        String            @default("CONCOURSE") // legacy slug level (concourse/platform)
  thumbnailUrl String?           // thumbnail preview scene
  order        Int               @default(0) // urutan jalur jalan dalam area
  hotspots     Json              @default("[]") // array hotspot — paralel placedAssets di floorplan
  canvasData   Json?             // initialView {yaw,pitch,hfov}, editor viewport state
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([stationId, sceneId])
  @@map("virtual_tour_scenes")
}

model CommercialSpace {
  id              String        @id @default(cuid())
  stationId       String
  station         Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            SpaceType     @default(KIOS)
  status          SpaceStatus   @default(TERSEDIA)
  area            Float
  monthlyRent     Float
  deposit         Float         @default(0)
  floor           String        @default("G")
  location        String
  nearestExit     String?
  exposure        Int           @default(0)
  powerSupply     String?
  waterAccess     Boolean       @default(false)
  airConditioning Boolean       @default(false)
  description     String?
  panoramaUrl     String?
  tenantLeads     TenantLead[]
  visitEvents     VisitEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([stationId, code])
  @@map("commercial_spaces")
}

model TenantLead {
  id               String           @id @default(cuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  spaceId          String?
  space            CommercialSpace? @relation(fields: [spaceId], references: [id])
  companyName      String
  contactName      String
  phone            String
  email            String
  businessType     String
  spaceRequirement String?
  message          String?
  status           LeadStatus       @default(NEW)
  notes            String?
  followUpAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("tenant_leads")
}

model VisitEvent {
  id        String           @id @default(cuid())
  stationId String?
  station   Station?         @relation(fields: [stationId], references: [id])
  spaceId   String?
  space     CommercialSpace? @relation(fields: [spaceId], references: [id])
  eventType EventType
  sessionId String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@map("visit_events")
}

enum UserRole {
  ADMIN
  EDITOR
  MITRA
}

enum SpaceType {
  KIOS
  RUKO
  ATM
  VENDING
  MEDIA_IKLAN
  AREA_PROMOSI
}

enum SpaceStatus {
  TERSEDIA
  TERISI
  MAINTENANCE
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum EventType {
  STATION_VIEW
  SPACE_VIEW
  TOUR_START
  FORM_SUBMIT
  WHATSAPP_CLICK
  PDF_DOWNLOAD
}
