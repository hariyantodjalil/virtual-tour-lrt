generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  avatarUrl   String?
  role        UserRole     @default(EDITOR)
  isActive    Boolean      @default(true)
  tenantLeads TenantLead[]
  tenants     Tenant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

model Station {
  id                     String              @id @default(cuid())
  code                   String?             @unique // Kode stasiun resmi (DKA, SET, dll.) — selaras portal-lrt
  name                   String
  nameId                 String? // Nama tampilan ID (biasanya sama dengan name)
  slug                   String              @unique
  line                   String
  address                String
  location               String? // Wilayah: Jakarta Selatan, Kota Bekasi, dll.
  dailyPassengers        Int                 @default(0)
  latitude               Float?
  longitude              Float?
  imageUrl               String?
  description            String?
  commercialContactPhone String?
  order                  Int                 @default(0)
  isActive               Boolean             @default(true)
  commercialSpaces       CommercialSpace[]
  visitEvents            VisitEvent[]
  virtualTourScenes      VirtualTourScene[]
  virtualTourLevels      VirtualTourLevel[]
  virtualTourAreas       VirtualTourArea[]
  virtualTour            StationVirtualTour?
  tenants                Tenant[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([isActive, order])
  @@map("stations")
}

/** Singleton profil kontak yang menjadi sumber utama seluruh kanal komersial publik. */
model CommercialProfile {
  id                     String   @id @default("default")
  teamName               String   @default("Tim Komersial LRT Jabodebek")
  contactPersonName      String?
  whatsappNumber         String   @default("628118012012")
  phoneNumber            String?
  email                  String?
  officeAddress          String?
  defaultWhatsappMessage String   @default("Halo, saya tertarik ruang komersial LRT Jabodebek. Mohon info lebih lanjut.")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("commercial_profiles")
}

// Agregat konfigurasi virtual tour per stasiun — paralel station_floorplans di portal-lrt.
// Scene & hotspot tetap dinormalisasi di virtual_tour_scenes.
model StationVirtualTour {
  id        String   @id @default(cuid())
  stationId String   @unique
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // defaultSceneId, initialViews per scene, editorSettings
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("station_virtual_tours")
}

// Level tur per stasiun: Concourse, Peron, Outdoor, dll.
model VirtualTourLevel {
  id        String             @id @default(cuid())
  stationId String
  station   Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  color     String             @default("#10b981")
  hint      String?
  order     Int                @default(0)
  isActive  Boolean            @default(true)
  areas     VirtualTourArea[]
  scenes    VirtualTourScene[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stationId, slug])
  @@map("virtual_tour_levels")
}

// Area dalam level: Paid Concourse, Unpaid Concourse, koridor A, dll.
model VirtualTourArea {
  id        String             @id @default(cuid())
  stationId String
  station   Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  levelId   String
  level     VirtualTourLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  order     Int                @default(0)
  isActive  Boolean            @default(true)
  scenes    VirtualTourScene[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stationId, slug])
  @@map("virtual_tour_areas")
}

model VirtualTourScene {
  id                  String            @id @default(cuid())
  stationId           String
  station             Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  levelId             String?
  levelRef            VirtualTourLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  areaId              String?
  areaRef             VirtualTourArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sceneId             String // slug scene: concourse, gate-area, platform
  title               String
  panoramaUrl         String // path S3 equirectangular — paralel svgPath di floorplan
  originalPanoramaUrl String?
  level               String            @default("CONCOURSE") // legacy slug level (concourse/platform)
  thumbnailUrl        String? // thumbnail preview scene
  order               Int               @default(0) // urutan jalur jalan dalam area
  hotspots            Json              @default("[]") // array hotspot — paralel placedAssets di floorplan
  canvasData          Json? // initialView {yaw,pitch,hfov}, editor viewport state
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([stationId, sceneId])
  @@map("virtual_tour_scenes")
}

model CommercialSpace {
  id              String       @id @default(cuid())
  stationId       String
  station         Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            SpaceType    @default(KIOS)
  status          SpaceStatus  @default(TERSEDIA)
  area            Float
  monthlyRent     Float
  deposit         Float        @default(0)
  floor           String       @default("G")
  location        String
  nearestExit     String?
  nearbyFacilities String[]      @default([])
  exposure        Int          @default(0)
  powerSupply     String?
  waterAccess     Boolean      @default(false)
  airConditioning Boolean      @default(false)
  description     String?
  panoramaUrl     String?
  tenantLeads     TenantLead[]
  visitEvents     VisitEvent[]
  occupancy       SpaceOccupancy?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([stationId, code])
  @@map("commercial_spaces")
}

/** Tenant aktif (brand yang mengisi unit TERISI) — beda dari TenantLead (pipeline calon). */
model Tenant {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  stationId   String
  station     Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  brandName   String
  contactName String?
  phone       String?
  email       String?
  logoUrl     String?
  notes       String?
  isActive    Boolean          @default(true)
  occupancies SpaceOccupancy[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([stationId])
  @@index([userId])
  @@map("tenants")
}

/** Satu occupancy aktif per unit — menandai tenant yang mengisi CommercialSpace. */
model SpaceOccupancy {
  id        String          @id @default(cuid())
  spaceId   String          @unique
  space     CommercialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@map("space_occupancies")
}

model TenantLead {
  id               String           @id @default(cuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  spaceId          String?
  space            CommercialSpace? @relation(fields: [spaceId], references: [id])
  companyName      String
  contactName      String
  phone            String
  email            String
  businessType     String
  spaceRequirement String?
  surveyPreference String?
  siteVisitStatus  SiteVisitStatus @default(NONE)
  siteVisitScheduledAt DateTime?
  message          String?
  status           LeadStatus       @default(NEW)
  notes            String?
  followUpAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("tenant_leads")
}

model VisitEvent {
  id        String           @id @default(cuid())
  stationId String?
  station   Station?         @relation(fields: [stationId], references: [id])
  spaceId   String?
  space     CommercialSpace? @relation(fields: [spaceId], references: [id])
  eventType EventType
  sessionId String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([eventType, createdAt])
  @@index([stationId, eventType])
  @@map("visit_events")
}

enum UserRole {
  ADMIN
  EDITOR
  MITRA
}

enum SpaceType {
  KIOS
  RUKO
  ATM
  VENDING
  MEDIA_IKLAN
  AREA_PROMOSI
}

enum SpaceStatus {
  TERSEDIA
  TERISI
  MAINTENANCE
  RESERVED
  FIT_OUT
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  PKS
  FIT_OUT_HANDOVER
  COMMERCIAL_OPERATION
  CLOSED_WON
  CLOSED_LOST
}

enum SiteVisitStatus {
  NONE
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventType {
  STATION_VIEW
  SPACE_VIEW
  TRAIN_VIEW
  TOUR_START
  FORM_SUBMIT
  WHATSAPP_CLICK
  PDF_DOWNLOAD
}

enum TrainRentalStatus {
  TERSEDIA
  TERBATAS
  PENUH
}

// ─── Virtual Train (parallel stack — mirip virtual tour stasiun) ─────────────

model Train {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  formation       String?
  imageUrl        String?
  order           Int               @default(0)
  isActive        Boolean           @default(true)
  trainTourCars   TrainTourCar[]
  trainTourZones  TrainTourZone[]
  trainTourScenes TrainTourScene[]
  virtualTour     TrainVirtualTour?
  rentalSpaces    TrainRentalSpace[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isActive, order])
  @@map("trains")
}

model TrainVirtualTour {
  id        String   @id @default(cuid())
  trainId   String   @unique
  train     Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("train_virtual_tours")
}

/** Gerbong kereta — paralel VirtualTourLevel */
model TrainTourCar {
  id        String           @id @default(cuid())
  trainId   String
  train     Train            @relation(fields: [trainId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  color     String           @default("#3b82f6")
  hint      String?
  order     Int              @default(0)
  isActive  Boolean          @default(true)
  zones     TrainTourZone[]
  scenes    TrainTourScene[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([trainId, slug])
  @@map("train_tour_cars")
}

/** Zona dalam gerbong — paralel VirtualTourArea */
model TrainTourZone {
  id        String           @id @default(cuid())
  trainId   String
  train     Train            @relation(fields: [trainId], references: [id], onDelete: Cascade)
  carId     String
  car       TrainTourCar     @relation(fields: [carId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  order     Int              @default(0)
  isActive  Boolean          @default(true)
  scenes    TrainTourScene[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([trainId, slug])
  @@map("train_tour_zones")
}

model TrainTourScene {
  id                  String         @id @default(cuid())
  trainId             String
  train               Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  carId               String?
  carRef              TrainTourCar?  @relation(fields: [carId], references: [id], onDelete: SetNull)
  zoneId              String?
  zoneRef             TrainTourZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sceneId             String
  title               String
  panoramaUrl         String
  originalPanoramaUrl String?
  car                 String         @default("gerbong-1")
  thumbnailUrl        String?
  order               Int            @default(0)
  hotspots            Json           @default("[]")
  canvasData          Json?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([trainId, sceneId])
  @@map("train_tour_scenes")
}

/** Ruang sewa iklan di interior kereta — carousel landing train */
model TrainRentalSpace {
  id                  String            @id @default(cuid())
  trainId             String
  train               Train             @relation(fields: [trainId], references: [id], onDelete: Cascade)
  displayNumber       String
  title               String
  description         String?
  imageUrl            String?
  objectPosition      String            @default("50% 50%")
  availableTrainsets  String[]          @default([])
  availableByCar      Json              @default("{}")
  howToOrder          String?
  status              TrainRentalStatus @default(TERSEDIA)
  monthlyRent         Float?
  order               Int               @default(0)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([trainId, displayNumber])
  @@index([trainId, isActive, order])
  @@map("train_rental_spaces")
}
