{
  "name": "virtual-tour-lrt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/bin.mjs next dev --webpack",
    "dev:turbo": "node scripts/bin.mjs next dev --turbopack",
    "build": "node scripts/bin.mjs next build --webpack",
    "start": "node scripts/bin.mjs next start",
    "lint": "node scripts/bin.mjs eslint",
    "test:spatial": "node --import tsx --test lib/spatial/geometry/*.test.ts",
    "db:generate": "node scripts/bin.mjs prisma generate",
    "db:deploy": "node scripts/bin.mjs prisma migrate deploy",
    "db:deploy:recover": "sh scripts/prisma-migrate-deploy.sh",
    "db:migrate": "node scripts/bin.mjs prisma migrate dev",
    "db:seed": "node scripts/bin.mjs tsx prisma/seed.ts",
    "db:studio": "node scripts/bin.mjs prisma studio"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "8.5.32"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "next": "^16.4.3",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
